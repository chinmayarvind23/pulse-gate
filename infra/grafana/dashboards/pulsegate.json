{
  "refresh": "5s",
  "title": "PulseGate operations",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(pulsegate_http_requests_total{code=\"202\"}[1m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "uid": "pulsegate-prometheus",
        "type": "prometheus"
      },
      "type": "timeseries",
      "gridPos": {
        "y": 0.0,
        "w": 12,
        "x": 0,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "title": "Admission rate",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.99,sum by(le)(rate(pulsegate_ack_duration_seconds_bucket[1m])))",
